
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Google Drive
# Recomenda-se usar o ID diretamente.
DRIVE_FOLDER_ID=
DRIVE_FOLDER_NAME=Dashboard
DRIVE_SHARED_DRIVE_ID=

# Banco
DB_PATH=data/analytics.duckdb

# Ingestão
RECURSIVE_DRIVE_SCAN=false
MAX_FILE_SIZE_MB=100

# Agente
MAX_TOOL_ROUNDS=8
MAX_QUERY_ROWS=500
